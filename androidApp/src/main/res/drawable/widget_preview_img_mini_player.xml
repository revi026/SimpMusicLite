<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage for launchers below API 31; see widget_preview_img_turntable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1B1F" />
            <corners android:radius="18dp" />
            <size android:width="250dp" android:height="64dp" />
        </shape>
    </item>
    <item android:width="44dp" android:height="44dp" android:left="10dp" android:gravity="left|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#33323A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:width="70dp" android:height="8dp" android:left="64dp" android:gravity="left|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:width="40dp" android:height="40dp" android:right="46dp" android:gravity="right|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#732E2E2E" />
        </shape>
    </item>
</layer-list>
