<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the 4x1 player bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="64dp"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_preview_art"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@drawable/widget_preview_line"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:background="@drawable/widget_preview_line"
            android:contentDescription="@null" />
    </LinearLayout>

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:padding="5dp"
        android:src="@drawable/rounded_skip_previous_24" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_play_disc"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/rounded_play_arrow_24" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:padding="5dp"
        android:src="@drawable/rounded_skip_next_24" />
</LinearLayout>
